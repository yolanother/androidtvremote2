{
  "enforcement": "warn",
  "docsPaths": [
    "docs/",
    "README.md"
  ],
  "syncTargets": [
    "CLAUDE.md",
    "AGENTS.md",
    ".cursorrules"
  ],
  "autoSyncDocs": true,
  "autoSyncInstructions": true,
  "hintOnMissingDocs": true,
  "hintOnMissingTests": true,
  "autoRefreshCodeGraph": true,
  "headerEnforcement": "warn",
  "autoIngestGrepReads": false,
  "agentActivity": {
    "enabled": true,
    "taskEnforcement": "block"
  }
}
